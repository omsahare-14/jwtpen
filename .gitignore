# Python bytecode and caches
__pycache__/
*.pyc
*.pyo

# Virtual environments. Several names are listed because contributors pick
# different ones and an accidentally committed venv is tens of thousands of files.
.venv/
venv/
env/

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Engagement data.
#
# This is the section that matters most here. jwtpen handles live credentials:
# captured requests, session tokens, secrets it cracks, and private keys it
# generates. None of that belongs in version control, and anything committed
# once stays retrievable from history even after it is deleted. These patterns
# are deliberately broad.
reports/
*.pem
*.key
*.p12
*.pfx
*.jwt
*.har
*.pdf
.env
.env.*

# Build artefacts, if packaging is ever added
build/
dist/
*.egg-info/

# Editor and operating system files
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
